programa {

  funcao inicio() {
    exibir_dados("Dev","20:30")
    exibir_dados("C#","20:55")
    exibir_dados("PS","21:30")

  }
    funcao exibir_dados(cadeia curso, cadeia hr_intervalo){
      escreva("Nome do curso: ", curso, "\n")
      escreva("Intervalo começa ás ", hr_intervalo, "horas\n\n")
      }
}
