programa {
  inteiro numeros[] = {10,20,20,30,10,20,30}
  inteiro qtde = 0
  inteiro tam = 1
  inteiro vinte[tam] 
  funcao inicio() {
    para(inteiro i = 0;i < 7;i++){
      se(numeros[i] == 20){
        qtde = qtde + 1
      }
    }
    tam = qtde
    para(inteiro i = 0; i < tam; i++){
      vinte[i]
    }
  }
}
